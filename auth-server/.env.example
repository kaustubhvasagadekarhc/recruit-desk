# Copy to .env (git-ignored). Nothing here is required for local development.
DATABASE_URL=sqlite:///./auth.db
# Public address of this server; invite and reset links are built from it.
BASE_URL=http://localhost:8000
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
# Optional mail. Without SMTP_HOST nothing is emailed: an admin gets the invite or reset link in the API response.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Recruit Desk <no-reply@example.com>
