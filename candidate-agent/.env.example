# Copy to .env and fill in. .env is never committed, printed or read by the agent.
# Optional: higher Exa rate limits (free key at https://dashboard.exa.ai). Without it the
# claude.ai Exa connector or the keyless https://mcp.exa.ai/mcp endpoint is used.
EXA_API_KEY=
# Optional: HasData Indeed MCP (free key at https://hasdata.com). Off until you enable it.
HASDATA_API_KEY=
