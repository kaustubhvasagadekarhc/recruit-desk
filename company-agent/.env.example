# Copy to .env and fill only what you have. Never commit or print this file.
# All keys are optional; the agent works without any of them.

# Exa: only needed if you use the .mcp.json "exa" server outside claude.ai.
# The claude.ai Exa connector already works without a key here.
EXA_API_KEY=

# Firecrawl (free tier at https://firecrawl.dev). Leave blank to keep Firecrawl off.
FIRECRAWL_API_KEY=

# Contact address sent in the crawler's User-Agent so site owners can reach you.
CRAWLER_CONTACT=
