{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob",
      "Grep",
      "Bash(uv run python scripts/run_company.py *)",
      "Bash(uv run python scripts/scan.py *)",
      "Bash(uv run python scripts/crawl.py *)",
      "Bash(uv run python scripts/ats.py *)",
      "Bash(uv run python scripts/dedupe.py *)",
      "Bash(uv run python scripts/excel_upsert.py *)",
      "Bash(uv run python scripts/memory.py *)",
      "Bash(uv run python scripts/progress.py *)",
      "Bash(uv run python scripts/validate_rows.py *)",
      "Bash(uv run python scripts/tools.py *)",
      "Bash(uv run python scripts/blockers.py *)",
      "Bash(uv run python scripts/retention.py)",
      "Bash(uv run python scripts/digest.py *)",
      "Bash(uv run python scripts/rescan_watchlist.py *)",
      "Bash(uv run python scripts/test_netsafe.py*)",
      "Bash(python3 hooks/test_hook.py)",
      "Bash(uv sync)",
      "Bash(ls *)",
      "mcp__claude_ai_Exa__web_search_exa",
      "mcp__claude_ai_Exa__web_fetch_exa",
      "mcp__exa__web_search_exa",
      "mcp__exa__crawling_exa",
      "mcp__exa__web_fetch_exa"
    ],
    "deny": [
      "Read(./.env)",
      "Read(../candidate-agent/**)",
      "Edit(../candidate-agent/**)",
      "Write(../candidate-agent/**)",
      "Edit(../BRIEF.md)",
      "Write(../BRIEF.md)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Bash(git *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(rm -rf *)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "mcp__linkedin*",
      "WebFetch(domain:linkedin.com)",
      "WebFetch(domain:www.linkedin.com)",
      "WebFetch(domain:indeed.com)",
      "WebFetch(domain:in.indeed.com)",
      "WebFetch(domain:www.indeed.com)",
      "Read(./.env.*)",
      "Bash(sqlite3)",
      "Bash(sqlite3 *)",
      "Bash(* .shell*)",
      "Bash(* .system*)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(uv run python -c *)",
      "Bash(uv run --with *)",
      "Bash(uv run -- *)",
      "Bash(uvx *)",
      "Bash(uv pip *)",
      "Bash(uv add *)",
      "Bash(uv tool *)",
      "Bash(node -e *)",
      "Bash(perl -e *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(* --apply*)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./hooks/**)",
      "Write(./hooks/**)",
      "Edit(./db/**)",
      "Write(./db/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./pyproject.toml)",
      "Write(./pyproject.toml)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)",
      "Write(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./backups/**)",
      "Edit(./backups/**)",
      "Bash(* --builder*)"
    ]
  },
  "enabledMcpjsonServers": [
    "exa"
  ],
  "disabledMcpjsonServers": [
    "firecrawl"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_use.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
