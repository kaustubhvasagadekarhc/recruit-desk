    {"ats": "taleo", "label": "Taleo", "host": "^[a-z0-9-]+\\.taleo\\.net$", "added_by": "builder", "added": "2026-10-15"},
    {"ats": "successfactors", "label": "SuccessFactors", "host": "^[a-z0-9-]+\\.successfactors\\.(?:com|eu)$", "added_by": "builder", "added": "2026-10-15"},
    {"ats": "jobvite", "label": "Jobvite", "host": "^jobs\\.jobvite\\.com$", "slug": "^https?://jobs\\.jobvite\\.com/(?P<slug>[a-z0-9-]+)", "added_by": "builder", "added": "2026-10-15"},
