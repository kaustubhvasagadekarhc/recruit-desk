{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./**)",
      "Edit(./runs/**)",
      "Write(./runs/**)",
      "Glob",
      "Grep",
      "Bash(uv run python scripts/lookup.py *)",
      "Bash(uv run python scripts/roles_from_company_agent.py *)",
      "Bash(uv run python scripts/assemble.py *)",
      "Bash(uv run python scripts/starter.py *)",
      "Bash(uv run python scripts/excel_upsert.py *)",
      "Bash(uv run python scripts/memory.py *)",
      "Bash(uv run python scripts/progress.py *)",
      "Bash(uv run python scripts/validate_rows.py *)",
      "Bash(uv run python scripts/match_team.py *)",
      "Bash(uv run python scripts/batch.py *)",
      "Bash(uv run python scripts/contacts.py *)",
      "Bash(uv run python scripts/apollo.py *)",
      "Bash(uv run python scripts/retention.py)",
      "Bash(uv run python scripts/retention.py --days *)",
      "Bash(python3 hooks/test_hook.py)",
      "Bash(uv sync)",
      "Bash(ls *)",
      "mcp__exa__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./team.csv)",
      "Edit(./team.csv)",
      "Write(./team.csv)",
      "Read(../candidate-agent/**)",
      "Edit(../candidate-agent/**)",
      "Write(../candidate-agent/**)",
      "Read(../company-agent/**)",
      "Edit(../company-agent/**)",
      "Write(../company-agent/**)",
      "Edit(../BRIEF.md)",
      "Write(../BRIEF.md)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Bash(git *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(rm -rf *)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "mcp__linkedin*",
      "WebFetch(domain:linkedin.com)",
      "WebFetch(domain:www.linkedin.com)",
      "WebFetch(domain:indeed.com)",
      "WebFetch(domain:in.indeed.com)",
      "WebFetch(domain:www.indeed.com)",
      "Bash(sqlite3)",
      "Bash(sqlite3 *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(uv run python -c *)",
      "Bash(uv run --with *)",
      "Bash(uv run -- *)",
      "Bash(uvx *)",
      "Bash(uv pip *)",
      "Bash(uv add *)",
      "Bash(uv tool *)",
      "Bash(node -e *)",
      "Bash(perl -e *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(* --apply*)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./hooks/**)",
      "Write(./hooks/**)",
      "Edit(./db/**)",
      "Write(./db/**)",
      "Edit(./schema/**)",
      "Write(./schema/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)",
      "Edit(./pyproject.toml)",
      "Write(./pyproject.toml)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)",
      "Write(./**/*.py)",
      "Edit(./**/*.py)",
      "Write(./**/*.xlsx)",
      "Edit(./**/*.xlsx)"
    ]
  },
  "enabledMcpjsonServers": [
    "exa"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|Bash|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/pre_tool_use.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
