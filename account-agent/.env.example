# Copy to .env and fill only what you have. Never commit or print this file.
# All keys are optional; the account agent v1 works without any of them.

# Exa: the hosted server in .mcp.json works without a key.
EXA_API_KEY=

# Contact address sent in the User-Agent of page and SEC EDGAR requests (SEC asks for one).
CRAWLER_CONTACT=

# Apollo.io (optional, paid): leaders' verified emails and directly returned phones. Without a key the scan
# uses free sources only. APOLLO_MAX_CREDITS caps people-enrichment calls per company (default 6).
APOLLO_API_KEY=
APOLLO_MAX_CREDITS=6
